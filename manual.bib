@article{Perelson76aa,
	abstract = {Abstract The bond graph language is introduced as a means of describing the topology of an electrical network composed of one-port and multi-port elements in a condensed alphanumeric notation suitable for computer interfacing. Series-parallel networks are represented in the particularly simple form of bond graph trees. Wiring operators, introduced by Penfield, can be constructed from bond graph junctions. Concepts from circuit theory can usefully be applied to nonelectrical systems which often are modeled by using multiport elements. For such systems bond graphs may provide a simpler description than conventional circuit diagrams.},
	author = {Perelson, Alan S.},
	doi = {https://doi.org/10.1002/cta.4490040202},
